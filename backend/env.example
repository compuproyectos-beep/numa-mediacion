# Copia este archivo como ".env" y llena los valores reales.
# El archivo ".env" real NUNCA se sube a git (ya está en .gitignore).

DATABASE_URL=postgresql://usuario:password@host:5432/postgres

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=actas-pdf
SUPABASE_STORAGE_LIMIT_GB=1

# Genera una clave con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Dominios permitidos a llamar a este backend, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000
